  91:USB_DEVICE/App/usbd_custom_hid_if.c **** __ALIGN_BEGIN static uint8_t CUSTOM_HID_ReportDesc_FS[USBD_CUSTOM_HID_REPORT_DESC_SIZE] __ALIGN_END
  92:USB_DEVICE/App/usbd_custom_hid_if.c **** {
  93:USB_DEVICE/App/usbd_custom_hid_if.c ****   /* USER CODE BEGIN 0 */
  94:USB_DEVICE/App/usbd_custom_hid_if.c ****   /* Generic dual-stick gamepad. 6-byte input report:
  95:USB_DEVICE/App/usbd_custom_hid_if.c ****    *   byte 0 : X   (left  stick, ADC1_IN1 / PA1)
  96:USB_DEVICE/App/usbd_custom_hid_if.c ****    *   byte 1 : Y   (left  stick, ADC1_IN2 / PA2)
  97:USB_DEVICE/App/usbd_custom_hid_if.c ****    *   byte 2 : Z   (right stick, ADC1_IN4 / PA4)
  98:USB_DEVICE/App/usbd_custom_hid_if.c ****    *   byte 3 : Rz  (right stick, ADC1_IN5 / PA5)
  99:USB_DEVICE/App/usbd_custom_hid_if.c ****    *   byte 4 : bits 0..3 hat switch, bits 4..7 padding
 100:USB_DEVICE/App/usbd_custom_hid_if.c ****    *   byte 5 : buttons 1..8, bit 0 = button 1
 101:USB_DEVICE/App/usbd_custom_hid_if.c ****    * X/Y + Z/Rz is the usual DirectInput pairing for two sticks, so Windows
 102:USB_DEVICE/App/usbd_custom_hid_if.c ****    * and anything built on SDL treat this as an ordinary gamepad.
 103:USB_DEVICE/App/usbd_custom_hid_if.c ****    */
 104:USB_DEVICE/App/usbd_custom_hid_if.c ****   0x05, 0x01,        /* Usage Page (Generic Desktop)         */
 105:USB_DEVICE/App/usbd_custom_hid_if.c ****   0x09, 0x05,        /* Usage (Game Pad)                     */
 106:USB_DEVICE/App/usbd_custom_hid_if.c ****   0xA1, 0x01,        /* Collection (Application)             */
 107:USB_DEVICE/App/usbd_custom_hid_if.c ****   0xA1, 0x00,        /*   Collection (Physical)              */
 108:USB_DEVICE/App/usbd_custom_hid_if.c ****   /* ---- four 8-bit analog axes ---- */
 109:USB_DEVICE/App/usbd_custom_hid_if.c ****   0x05, 0x01,        /*     Usage Page (Generic Desktop)     */
 110:USB_DEVICE/App/usbd_custom_hid_if.c ****   0x09, 0x30,        /*     Usage (X)                        */
 111:USB_DEVICE/App/usbd_custom_hid_if.c ****   0x09, 0x31,        /*     Usage (Y)                        */
 112:USB_DEVICE/App/usbd_custom_hid_if.c ****   0x09, 0x32,        /*     Usage (Z)                        */
 113:USB_DEVICE/App/usbd_custom_hid_if.c ****   0x09, 0x35,        /*     Usage (Rz)                       */
 114:USB_DEVICE/App/usbd_custom_hid_if.c ****   0x15, 0x00,        /*     Logical Minimum (0)              */
 115:USB_DEVICE/App/usbd_custom_hid_if.c ****   0x26, 0xFF, 0x00,  /*     Logical Maximum (255)            */
 116:USB_DEVICE/App/usbd_custom_hid_if.c ****   0x35, 0x00,        /*     Physical Minimum (0)             */
 117:USB_DEVICE/App/usbd_custom_hid_if.c ****   0x46, 0xFF, 0x00,  /*     Physical Maximum (255)           */
 118:USB_DEVICE/App/usbd_custom_hid_if.c ****   0x75, 0x08,        /*     Report Size (8)                  */
 119:USB_DEVICE/App/usbd_custom_hid_if.c ****   0x95, 0x04,        /*     Report Count (4)                 */
 120:USB_DEVICE/App/usbd_custom_hid_if.c ****   0x81, 0x02,        /*     Input (Data,Var,Abs)             */
 121:USB_DEVICE/App/usbd_custom_hid_if.c ****   /* ---- d-pad as a proper hat switch ---- */
 122:USB_DEVICE/App/usbd_custom_hid_if.c ****   0x09, 0x39,        /*     Usage (Hat Switch)               */
 123:USB_DEVICE/App/usbd_custom_hid_if.c ****   0x15, 0x00,        /*     Logical Minimum (0)              */
 124:USB_DEVICE/App/usbd_custom_hid_if.c ****   0x25, 0x07,        /*     Logical Maximum (7)              */
 125:USB_DEVICE/App/usbd_custom_hid_if.c ****   0x35, 0x00,        /*     Physical Minimum (0)             */
 126:USB_DEVICE/App/usbd_custom_hid_if.c ****   0x46, 0x3B, 0x01,  /*     Physical Maximum (315 degrees)   */
 127:USB_DEVICE/App/usbd_custom_hid_if.c ****   0x65, 0x14,        /*     Unit (Eng Rotation: Degrees)     */
 128:USB_DEVICE/App/usbd_custom_hid_if.c ****   0x75, 0x04,        /*     Report Size (4)                  */
 129:USB_DEVICE/App/usbd_custom_hid_if.c ****   0x95, 0x01,        /*     Report Count (1)                 */
 130:USB_DEVICE/App/usbd_custom_hid_if.c ****   0x81, 0x42,        /*     Input (Data,Var,Abs,Null State)  */
 131:USB_DEVICE/App/usbd_custom_hid_if.c ****   0x65, 0x00,        /*     Unit (None)                      */
 132:USB_DEVICE/App/usbd_custom_hid_if.c ****   0x75, 0x04,        /*     Report Size (4)                  */
 133:USB_DEVICE/App/usbd_custom_hid_if.c ****   0x95, 0x01,        /*     Report Count (1)                 */
 134:USB_DEVICE/App/usbd_custom_hid_if.c ****   0x81, 0x03,        /*     Input (Const,Var,Abs) - padding  */
 135:USB_DEVICE/App/usbd_custom_hid_if.c ****   /* ---- eight buttons ---- */
 136:USB_DEVICE/App/usbd_custom_hid_if.c ****   0x05, 0x09,        /*     Usage Page (Button)              */
 137:USB_DEVICE/App/usbd_custom_hid_if.c ****   0x19, 0x01,        /*     Usage Minimum (Button 1)         */
 138:USB_DEVICE/App/usbd_custom_hid_if.c ****   0x29, 0x08,        /*     Usage Maximum (Button 8)         */
 139:USB_DEVICE/App/usbd_custom_hid_if.c ****   0x15, 0x00,        /*     Logical Minimum (0)              */
 140:USB_DEVICE/App/usbd_custom_hid_if.c ****   0x25, 0x01,        /*     Logical Maximum (1)              */
 141:USB_DEVICE/App/usbd_custom_hid_if.c ****   0x35, 0x00,        /*     Physical Minimum (0)             */
 142:USB_DEVICE/App/usbd_custom_hid_if.c ****   0x45, 0x01,        /*     Physical Maximum (1)             */
 143:USB_DEVICE/App/usbd_custom_hid_if.c ****   0x75, 0x01,        /*     Report Size (1)                  */
 144:USB_DEVICE/App/usbd_custom_hid_if.c ****   0x95, 0x08,        /*     Report Count (8)                 */
 145:USB_DEVICE/App/usbd_custom_hid_if.c ****   0x81, 0x02,        /*     Input (Data,Var,Abs)             */
 146:USB_DEVICE/App/usbd_custom_hid_if.c ****   0xC0,              /*   End Collection                     */
 147:USB_DEVICE/App/usbd_custom_hid_if.c ****   /* USER CODE END 0 */
