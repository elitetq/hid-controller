  91:USB_DEVICE/App/usbd_custom_hid_if.c **** __ALIGN_BEGIN static uint8_t CUSTOM_HID_ReportDesc_FS[] __ALIGN_END =
  92:USB_DEVICE/App/usbd_custom_hid_if.c **** {
  93:USB_DEVICE/App/usbd_custom_hid_if.c ****   /* USER CODE BEGIN 0 */
  94:USB_DEVICE/App/usbd_custom_hid_if.c ****   /* Xbox 360 style gamepad, DirectInput layout. 8-byte input report:
  95:USB_DEVICE/App/usbd_custom_hid_if.c ****    *   byte 0 : X   left  stick X      (ADC1_IN1 / PA1)
  96:USB_DEVICE/App/usbd_custom_hid_if.c ****    *   byte 1 : Y   left  stick Y      (ADC1_IN2 / PA2)
  97:USB_DEVICE/App/usbd_custom_hid_if.c ****    *   byte 2 : Z   triggers combined  (LT -> 0, rest 128, RT -> 255)
  98:USB_DEVICE/App/usbd_custom_hid_if.c ****    *   byte 3 : Rx  right stick X      (ADC1_IN4 / PA4)
  99:USB_DEVICE/App/usbd_custom_hid_if.c ****    *   byte 4 : Ry  right stick Y      (ADC1_IN5 / PA5)
 100:USB_DEVICE/App/usbd_custom_hid_if.c ****    *   byte 5 : bits 0..3 hat switch, bits 4..7 padding
 101:USB_DEVICE/App/usbd_custom_hid_if.c ****    *   byte 6 : buttons 1..8,  bit 0 = button 1
 102:USB_DEVICE/App/usbd_custom_hid_if.c ****    *   byte 7 : buttons 9..11, bits 3..7 padding
 103:USB_DEVICE/App/usbd_custom_hid_if.c ****    * Buttons: 1-4 face, 5 LB, 6 RB, 7 share, 8 start, 9 LSB, 10 RSB, 11 xbox.
 104:USB_DEVICE/App/usbd_custom_hid_if.c ****    * Usages X/Y/Z/Rx/Ry (0x30..0x34) are contiguous, so browsers - which index
 105:USB_DEVICE/App/usbd_custom_hid_if.c ****    * raw gamepad axes as (usage - 0x30) - report them as axes 0..4 with no gaps.
 106:USB_DEVICE/App/usbd_custom_hid_if.c ****    */
 107:USB_DEVICE/App/usbd_custom_hid_if.c ****   0x05, 0x01,        // Usage Page (Generic Desktop)         
 108:USB_DEVICE/App/usbd_custom_hid_if.c ****   0x09, 0x05,        // Usage (Game Pad)                     
 109:USB_DEVICE/App/usbd_custom_hid_if.c ****   0xA1, 0x01,        // Collection (Application)             
 110:USB_DEVICE/App/usbd_custom_hid_if.c ****   0xA1, 0x00,        //   Collection (Physical)              
 111:USB_DEVICE/App/usbd_custom_hid_if.c ****   /* ---- five 8-bit analog axes ---- */
 112:USB_DEVICE/App/usbd_custom_hid_if.c ****   0x05, 0x01,        //    Usage Page (Generic Desktop)     
 113:USB_DEVICE/App/usbd_custom_hid_if.c ****   0x09, 0x30,        //    Usage (X)   -- Right Joystick (X)
 114:USB_DEVICE/App/usbd_custom_hid_if.c ****   0x09, 0x31,        //    Usage (Y)   -- Left Joystick (Y)
 115:USB_DEVICE/App/usbd_custom_hid_if.c ****   0x09, 0x32,        //    Usage (Z)   -- LT                     
 116:USB_DEVICE/App/usbd_custom_hid_if.c ****   0x09, 0x33,        //    Usage (Rx)  -- Right Joystick (X)
 117:USB_DEVICE/App/usbd_custom_hid_if.c ****   0x09, 0x34,        //    Usage (Ry)  -- Right Joystick (Y)
 118:USB_DEVICE/App/usbd_custom_hid_if.c ****   0x09, 0x35,        //    Usage (Rz)  -- RT
 119:USB_DEVICE/App/usbd_custom_hid_if.c ****   0x15, 0x00,        //    Logical Minimum (0)              
 120:USB_DEVICE/App/usbd_custom_hid_if.c ****   0x26, 0xFF, 0x00,  //    Logical Maximum (255)            
 121:USB_DEVICE/App/usbd_custom_hid_if.c ****   0x35, 0x00,        //    Physical Minimum (0)             
 122:USB_DEVICE/App/usbd_custom_hid_if.c ****   0x46, 0xFF, 0x00,  //    Physical Maximum (255)           
 123:USB_DEVICE/App/usbd_custom_hid_if.c ****   0x75, 0x08,        //    Report Size (8)                  
 124:USB_DEVICE/App/usbd_custom_hid_if.c ****   0x95, 0x06,        //    Report Count (6)                 
 125:USB_DEVICE/App/usbd_custom_hid_if.c ****   0x81, 0x02,        //    Input (Data,Var,Abs)             
 126:USB_DEVICE/App/usbd_custom_hid_if.c ****   /* ---- d-pad as a proper hat switch ---- */
 127:USB_DEVICE/App/usbd_custom_hid_if.c ****   0x09, 0x39,        //    Usage (Hat Switch)               
 128:USB_DEVICE/App/usbd_custom_hid_if.c ****   0x15, 0x00,        //    Logical Minimum (0)              
 129:USB_DEVICE/App/usbd_custom_hid_if.c ****   0x25, 0x07,        //    Logical Maximum (7)              
 130:USB_DEVICE/App/usbd_custom_hid_if.c ****   0x35, 0x00,        //    Physical Minimum (0)             
 131:USB_DEVICE/App/usbd_custom_hid_if.c ****   0x46, 0x3B, 0x01,  //    Physical Maximum (315 degrees)   
 132:USB_DEVICE/App/usbd_custom_hid_if.c ****   0x65, 0x14,        //    Unit (Eng Rotation: Degrees)     
 133:USB_DEVICE/App/usbd_custom_hid_if.c ****   0x75, 0x04,        //    Report Size (4)                  
 134:USB_DEVICE/App/usbd_custom_hid_if.c ****   0x95, 0x01,        //    Report Count (1)                 
 135:USB_DEVICE/App/usbd_custom_hid_if.c ****   0x81, 0x42,        //    Input (Data,Var,Abs,Null State)  
 136:USB_DEVICE/App/usbd_custom_hid_if.c ****   0x65, 0x00,        //    Unit (None)                      
 137:USB_DEVICE/App/usbd_custom_hid_if.c ****   0x75, 0x04,        //    Report Size (4)                  
 138:USB_DEVICE/App/usbd_custom_hid_if.c ****   0x95, 0x01,        //    Report Count (1)                 
 139:USB_DEVICE/App/usbd_custom_hid_if.c ****   0x81, 0x03,        //    Input (Const,Var,Abs) - padding  
 140:USB_DEVICE/App/usbd_custom_hid_if.c ****   /* ---- ten buttons ---- */
 141:USB_DEVICE/App/usbd_custom_hid_if.c ****   0x05, 0x09,        //    Usage Page (Button)              
 142:USB_DEVICE/App/usbd_custom_hid_if.c ****   0x19, 0x01,        //    Usage Minimum (Button 1)         
 143:USB_DEVICE/App/usbd_custom_hid_if.c ****   0x29, 0x0A,        //    Usage Maximum (Button 10)        
 144:USB_DEVICE/App/usbd_custom_hid_if.c ****   0x15, 0x00,        //    Logical Minimum (0)              
 145:USB_DEVICE/App/usbd_custom_hid_if.c ****   0x25, 0x01,        //    Logical Maximum (1)              
 146:USB_DEVICE/App/usbd_custom_hid_if.c ****   0x35, 0x00,        //    Physical Minimum (0)             
 147:USB_DEVICE/App/usbd_custom_hid_if.c ****   0x45, 0x01,        //    Physical Maximum (1)             
ARM GAS  C:\Users\jonar\AppData\Local\Temp\ccwx2Dho.s 			page 4


 148:USB_DEVICE/App/usbd_custom_hid_if.c ****   0x75, 0x01,        //    Report Size (1)                  
 149:USB_DEVICE/App/usbd_custom_hid_if.c ****   0x95, 0x0A,        //    Report Count (10)                
 150:USB_DEVICE/App/usbd_custom_hid_if.c ****   0x81, 0x02,        //    Input (Data,Var,Abs)             
 151:USB_DEVICE/App/usbd_custom_hid_if.c ****   0x75, 0x01,        //    Report Size (1)                  
 152:USB_DEVICE/App/usbd_custom_hid_if.c ****   0x95, 0x06,        //    Report Count (6)                 
 153:USB_DEVICE/App/usbd_custom_hid_if.c ****   0x81, 0x03,        //    Input (Const,Var,Abs) - padding  
 154:USB_DEVICE/App/usbd_custom_hid_if.c ****   0xC0,              //  End Collection                     
 155:USB_DEVICE/App/usbd_custom_hid_if.c ****   /* USER CODE END 0 */
 156:USB_DEVICE/App/usbd_custom_hid_if.c ****   0xC0    /*     END_COLLECTION	             */
 157:USB_DEVICE/App/usbd_custom_hid_if.c **** };
