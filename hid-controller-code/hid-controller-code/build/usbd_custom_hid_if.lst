  91:USB_DEVICE/App/usbd_custom_hid_if.c **** __ALIGN_BEGIN static uint8_t CUSTOM_HID_ReportDesc_FS[USBD_CUSTOM_HID_REPORT_DESC_SIZE] __ALIGN_END
  92:USB_DEVICE/App/usbd_custom_hid_if.c **** {
  93:USB_DEVICE/App/usbd_custom_hid_if.c ****   /* USER CODE BEGIN 0 */
  94:USB_DEVICE/App/usbd_custom_hid_if.c ****   /* Gamepad: 4 analog axes + 8 buttons. 5-byte input report:
  95:USB_DEVICE/App/usbd_custom_hid_if.c ****    *   byte 0 : X   (left  stick X, ADC1_IN1 / PA1)
  96:USB_DEVICE/App/usbd_custom_hid_if.c ****    *   byte 1 : Y   (left  stick Y, ADC1_IN2 / PA2)
  97:USB_DEVICE/App/usbd_custom_hid_if.c ****    *   byte 2 : Rx  (right stick X, ADC1_IN4 / PA4)
  98:USB_DEVICE/App/usbd_custom_hid_if.c ****    *   byte 3 : Ry  (right stick Y, ADC1_IN5 / PA5)
  99:USB_DEVICE/App/usbd_custom_hid_if.c ****    *   byte 4 : buttons 1..8, bit 0 = button 1
 100:USB_DEVICE/App/usbd_custom_hid_if.c ****    */
 101:USB_DEVICE/App/usbd_custom_hid_if.c ****   0x05, 0x01,        /* Usage Page (Generic Desktop)     */
 102:USB_DEVICE/App/usbd_custom_hid_if.c ****   0x09, 0x05,        /* Usage (Game Pad)                 */
 103:USB_DEVICE/App/usbd_custom_hid_if.c ****   0xA1, 0x01,        /* Collection (Application)         */
 104:USB_DEVICE/App/usbd_custom_hid_if.c ****   0xA1, 0x00,        /*   Collection (Physical)          */
 105:USB_DEVICE/App/usbd_custom_hid_if.c ****   0x05, 0x01,        /*     Usage Page (Generic Desktop) */
 106:USB_DEVICE/App/usbd_custom_hid_if.c ****   0x09, 0x30,        /*     Usage (X)                    */
 107:USB_DEVICE/App/usbd_custom_hid_if.c ****   0x09, 0x31,        /*     Usage (Y)                    */
 108:USB_DEVICE/App/usbd_custom_hid_if.c ****   0x09, 0x33,        /*     Usage (Rx)                   */
 109:USB_DEVICE/App/usbd_custom_hid_if.c ****   0x09, 0x34,        /*     Usage (Ry)                   */
 110:USB_DEVICE/App/usbd_custom_hid_if.c ****   0x15, 0x00,        /*     Logical Minimum (0)          */
 111:USB_DEVICE/App/usbd_custom_hid_if.c ****   0x26, 0xFF, 0x00,  /*     Logical Maximum (255)        */
 112:USB_DEVICE/App/usbd_custom_hid_if.c ****   0x75, 0x08,        /*     Report Size (8)              */
 113:USB_DEVICE/App/usbd_custom_hid_if.c ****   0x95, 0x04,        /*     Report Count (4)             */
 114:USB_DEVICE/App/usbd_custom_hid_if.c ****   0x81, 0x02,        /*     Input (Data,Var,Abs)         */
 115:USB_DEVICE/App/usbd_custom_hid_if.c ****   0x05, 0x09,        /*     Usage Page (Button)          */
 116:USB_DEVICE/App/usbd_custom_hid_if.c ****   0x19, 0x01,        /*     Usage Minimum (Button 1)     */
 117:USB_DEVICE/App/usbd_custom_hid_if.c ****   0x29, 0x08,        /*     Usage Maximum (Button 8)     */
 118:USB_DEVICE/App/usbd_custom_hid_if.c ****   0x15, 0x00,        /*     Logical Minimum (0)          */
 119:USB_DEVICE/App/usbd_custom_hid_if.c ****   0x25, 0x01,        /*     Logical Maximum (1)          */
 120:USB_DEVICE/App/usbd_custom_hid_if.c ****   0x75, 0x01,        /*     Report Size (1)              */
 121:USB_DEVICE/App/usbd_custom_hid_if.c ****   0x95, 0x08,        /*     Report Count (8)             */
 122:USB_DEVICE/App/usbd_custom_hid_if.c ****   0x81, 0x02,        /*     Input (Data,Var,Abs)         */
 123:USB_DEVICE/App/usbd_custom_hid_if.c ****   0xC0,              /*   End Collection                 */
 124:USB_DEVICE/App/usbd_custom_hid_if.c ****   /* USER CODE END 0 */
 125:USB_DEVICE/App/usbd_custom_hid_if.c ****   0xC0    /*     END_COLLECTION	             */
 126:USB_DEVICE/App/usbd_custom_hid_if.c **** };
 127:USB_DEVICE/App/usbd_custom_hid_if.c **** 
 128:USB_DEVICE/App/usbd_custom_hid_if.c **** /* USER CODE BEGIN PRIVATE_VARIABLES */
 129:USB_DEVICE/App/usbd_custom_hid_if.c **** /* CubeMX regenerates usbd_conf.h and resets USBD_CUSTOM_HID_REPORT_DESC_SIZE to
 130:USB_DEVICE/App/usbd_custom_hid_if.c ****  * its default of 2, which silently truncates the descriptor above. Fail the
 131:USB_DEVICE/App/usbd_custom_hid_if.c ****  * build instead of shipping a 2-byte report descriptor. */
 132:USB_DEVICE/App/usbd_custom_hid_if.c **** _Static_assert(sizeof(CUSTOM_HID_ReportDesc_FS) == 47,
 133:USB_DEVICE/App/usbd_custom_hid_if.c ****                "USBD_CUSTOM_HID_REPORT_DESC_SIZE must be 47 - check usbd_conf.h");
 134:USB_DEVICE/App/usbd_custom_hid_if.c **** /* USER CODE END PRIVATE_VARIABLES */
