 407:Core/Src/main.c **** /* USER CODE BEGIN 4 */
 408:Core/Src/main.c **** static void gamepad_update_joysticks() {
 409:Core/Src/main.c ****   uint32_t avg_x, avg_y, avg_rx, avg_ry;
 410:Core/Src/main.c ****   avg_x = avg_y = avg_rx = avg_ry = 0;
 411:Core/Src/main.c ****   for(uint32_t i = 0; i < JOYSTICK_OVERSAMPLE; i++) {
 412:Core/Src/main.c ****     avg_x += joystick_buf[i*4];
 413:Core/Src/main.c ****     avg_y += joystick_buf[i*4+1];
 414:Core/Src/main.c ****     avg_rx += joystick_buf[i*4+2];
 415:Core/Src/main.c ****     avg_ry += joystick_buf[i*4+3];
 416:Core/Src/main.c ****   }
 417:Core/Src/main.c ****   gamepad_report.x = avg_x >> (JOYSTICK_OVERSAMPLE_BITS+4);
 418:Core/Src/main.c ****   gamepad_report.rx = avg_rx >> (JOYSTICK_OVERSAMPLE_BITS+4);
 419:Core/Src/main.c ****   gamepad_report.y = avg_y >> (JOYSTICK_OVERSAMPLE_BITS+4);
 420:Core/Src/main.c ****   gamepad_report.ry = avg_ry >> (JOYSTICK_OVERSAMPLE_BITS+4);
 421:Core/Src/main.c **** }
 422:Core/Src/main.c **** 
 423:Core/Src/main.c **** // num > 0 && num < 11
 424:Core/Src/main.c **** static void gamepad_set_button(uint8_t num, uint8_t val) {
 425:Core/Src/main.c ****   uint16_t bitmask = 0x0001 << (num-1);
 426:Core/Src/main.c ****   if(val)
 427:Core/Src/main.c ****     gamepad_report.buttons |= bitmask;
 428:Core/Src/main.c ****   else
 429:Core/Src/main.c ****     gamepad_report.buttons &= ~bitmask;
 430:Core/Src/main.c **** }
 431:Core/Src/main.c **** 
ARM GAS  /tmp/cczl2P5i.s 			page 13


 432:Core/Src/main.c **** static int get_dpad(uint8_t dpad_right, uint8_t dpad_down, uint8_t dpad_left, uint8_t dpad_up) {
 433:Core/Src/main.c ****   if(dpad_up) {
 434:Core/Src/main.c ****     if(dpad_right) return 1;
 435:Core/Src/main.c ****     else if(dpad_left) return 7;
 436:Core/Src/main.c ****     return 0;
 437:Core/Src/main.c ****   } else if(dpad_right) {
 438:Core/Src/main.c ****     return dpad_down + 2; // E - SE
 439:Core/Src/main.c ****   } else if(dpad_down) {
 440:Core/Src/main.c ****     return dpad_left + 4; // S - SW
 441:Core/Src/main.c ****   } else if(dpad_left) {
 442:Core/Src/main.c ****     return 6;
 443:Core/Src/main.c ****   }
 444:Core/Src/main.c ****   return 8; // no direction
 445:Core/Src/main.c **** }
 446:Core/Src/main.c **** 
 447:Core/Src/main.c **** static void gamepad_update_buttons() {
 448:Core/Src/main.c ****   gamepad_report.buttons = 0x0000; // 10101010 temp
 449:Core/Src/main.c ****   gamepad_report.hat = 8;        // centred - 0 would read as d-pad up
 450:Core/Src/main.c ****   gamepad_report.rt = 128;        // triggers released - 0 would read as LT held
 451:Core/Src/main.c ****   gamepad_report.lt = 128;        // triggers released - 0 would read as LT held
 452:Core/Src/main.c ****   gamepad_report.hat = get_dpad(0,0,0,0);
 453:Core/Src/main.c ****   return;
 454:Core/Src/main.c ****   // add actual gpio polling later
 455:Core/Src/main.c **** }
 456:Core/Src/main.c **** 
 457:Core/Src/main.c **** static void gamepad_update() {
 458:Core/Src/main.c ****   gamepad_update_joysticks();
 459:Core/Src/main.c ****   gamepad_update_buttons();
 460:Core/Src/main.c **** }
 461:Core/Src/main.c **** 
